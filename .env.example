PORT=8765
# 127.0.0.1 — только локально (безопасно по умолчанию).
# 0.0.0.0 — слушать все интерфейсы; снаружи обязательно reverse proxy + TLS.
BIND_HOST=127.0.0.1

# 1 — брать клиентский IP из X-Forwarded-For / X-Real-IP (только за своим proxy).
# Без proxy оставляйте выключенным: иначе лимиты заказов/логина/чата можно подделать.
# Публичный запуск: см. DEPLOY.md — proxy ОБЯЗАТЕЛЕН, прежде чем включать этот флаг.
TRUST_PROXY=0

ADMIN_PASSWORD=замени_на_длинный_пароль

# WhatsApp продавца (только цифры, без +). Один источник для заказов, чата и контактов.
WHATSAPP_PHONE=77028711150

# Лимит публичных заказов с одного IP (окно в миллисекундах).
# Локально/для одного оператора 20 нормально. Для публичного интернета — 5–8,
# иначе один недоброжелатель может быстро выбрать склад (см. DEPLOY.md).
ORDER_RATE_MAX=20
ORDER_RATE_WINDOW_MS=600000

# Максимальный размер тела POST /api/chat (байты).
# Файл до 4 МБ кодируется base64 (~×4/3) — ниже ~6 МБ режет валидные вложения.
CHAT_BODY_MAX=6000000
# Лимиты чата: запросов и файлов с одного IP за минуту; параллельные вызовы LLM.
CHAT_RATE_MAX=20
CHAT_FILE_RATE_MAX=5
CHAT_LLM_GLOBAL_MAX=4
CHAT_LLM_PER_IP_MAX=1

# Живая модель. Подойдут OpenAI, Groq и OpenRouter.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.4-mini
# Алиас для AI-слоя (если не задан — берётся WHATSAPP_PHONE).
# AI_WHATSAPP_PHONE=

# Картинки сайта и витрины лежат только в папке img/ (не в public/).
#
# Запуск:
#   start.bat          — основной (Docker)
#   stop.bat           — остановить Docker
#   start-local.bat    — без Docker (нужен Node >= 22.5)
#   docker compose up -d --build
#
# В контейнере BIND_HOST принудительно 0.0.0.0 (см. docker-compose.yml),
# наружу порт только 127.0.0.1:8765. Публично — DEPLOY.md.
# Prove-скрипты (_prove_*.cjs) меняют БД — только с ALLOW_PROVE=1.
